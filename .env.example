# ---------------------------------------------------------------------------
# Auto Dude Command Center — environment variables
# Copy to .env.local and fill in values from your Supabase project settings.
# Never commit .env.local. The service-role key must NEVER reach the browser.
# ---------------------------------------------------------------------------

# --- Supabase (public, safe for the browser — used for Auth login only) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server-only, service role — used by API routes) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- GoHighLevel webhook shared secret (Phase 6 prep; not live yet) ---
# Incoming GHL webhooks must send header:  x-autodude-webhook-secret: <this value>
GHL_WEBHOOK_SECRET=

# --- App URL (used for absolute links; optional) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
